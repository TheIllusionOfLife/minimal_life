# Experiment output data
# NOTE: .git/info/exclude used to have blanket rules; they are now consolidated here.
/experiments/*.json
/experiments/*.tsv
/experiments/*.gz
/experiments/logs/
/experiments/*_part_*.json
/experiments/ablation_sweep/
/experiments/threshold_sweep/
/experiments/boundary_sweep/
/experiments/fitness_*.json
/zenodo_staging/
# Keep manifest-bound source artifacts trackable.
!/experiments/coupling_analysis.json
!/experiments/final_graph_statistics.json
!/experiments/final_statistics.json
# Keep analysis outputs (synthesized, small, not raw sweep data).
!/experiments/criterion_reduction_analysis.json
!/experiments/surrogate_analysis.json
!/experiments/failure_mode_analysis.json
!/experiments/fitness_landscape_analysis.json
!/experiments/threshold_sensitivity_analysis.json
!/experiments/boundary_topology_analysis.json

